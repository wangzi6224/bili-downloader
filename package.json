{
  "name": "bili-downloader",
  "productName": "B站下载器",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "description": "粘贴 B站链接即可下载视频、合集、番剧与电影的 macOS 桌面应用",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "npm run verify && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:coverage",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:mac": "npm run build && npm run fetch-ffmpeg && electron-builder --mac --x64 --arm64 --publish never",
    "release": "node scripts/release.mjs --check && npm run build:mac && node scripts/release.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^7.30.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
